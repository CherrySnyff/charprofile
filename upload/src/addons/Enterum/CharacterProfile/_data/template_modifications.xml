<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="member_view" modification_key="enterum_cp_tabs_member_view" description="Character profile tabs on member_view" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<span class="hScroller-scroll">]]></find>
    <replace><![CDATA[<span class="hScroller-scroll">
					<xf:include template="enterum_char_profile_tab_links" />]]></replace>
  </modification>
