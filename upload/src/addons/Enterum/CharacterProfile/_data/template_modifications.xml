  <modification type="public" template="member_recent_content" modification_key="enterum_cp_tabs_member_recent" description="Character profile tabs on member_recent_content" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<span class="hScroller-scroll">]]></find>
